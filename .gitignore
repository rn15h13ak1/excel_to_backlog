# 設定ファイル（API キーを含むため除外）
# config.sample.yaml / config.minimal.yaml は別名でこの行にマッチしないため、
# 打ち消しの指定は要らない。どちらも資格情報を含まないので追跡する。
config.yaml

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# テスト用 Excel
*.xlsx
*.xls

# 出力・ログ
*.log
preview_*.md
run_*.csv

# pytest
.pytest_cache/
.coverage
htmlcov/

# 変異テスト
mutants/
.mutmut-cache

# Claude Code の作業用ディレクトリ（git worktree を含む）
.claude/

# 資格情報
# config.yaml は名指しで除外しているが、それ以外の置き場も塞いでおく。
# 一度コミットすると Git 履歴から消すのが難しいため。
.env
.env.*
secrets.yaml
credentials*
*.pem
*.key
*.local.yaml
# SSH の鍵（*.pem / *.key は拡張子にしか当たらないため、別に要る）
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
known_hosts

# mac-watcher のトリガー（.build-trigger 等）は、本リポジトリでは
# watcher を使っていないため定型から省いている。

# プレビュー・実行ログの出力先
output/
